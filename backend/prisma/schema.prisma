datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum SyncTrigger {
  MANUAL
  OAUTH
  SYSTEM
  INITIAL
}

enum NodeType {
  REPOSITORY
  DIRECTORY
  FILE
  MODULE
  CLASS
  FUNCTION
  INTERFACE
  COMPONENT
  API_ENDPOINT
  DATABASE_MODEL
}

enum EdgeType {
  CONTAINS
  IMPORTS
  DEPENDS_ON
  CALLS
  EXTENDS
  IMPLEMENTS
  EXPOSES
  USES
  DEFINES
}

model User {
  id            String                 @id @default(uuid())
  email         String                 @unique
  name          String?
  passwordHash  String
  role          Role                   @default(USER)
  isActive      Boolean                @default(true)
  lastLoginAt   DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions      Session[]
  gitHubAccount GitHubAccount?
  connections   RepositoryConnection[]

  @@index([email])
}

model Session {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedRefreshToken String    @unique
  userAgent          String
  ipAddress          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([hashedRefreshToken])
}

model GitHubAccount {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId         String   @unique
  username             String
  email                String?
  profileUrl           String?
  encryptedAccessToken String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([githubUserId])
}

model Repository {
  id                 String                 @id @default(uuid())
  githubRepositoryId String                 @unique
  ownerLogin         String
  name               String
  fullName           String
  description        String?
  htmlUrl            String
  defaultBranch      String
  visibility         String
  isPrivate          Boolean
  language           String?
  stars              Int                    @default(0)
  forks              Int                    @default(0)
  isArchived         Boolean                @default(false)
  connectedAt        DateTime               @default(now())
  lastSyncedAt       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  connections        RepositoryConnection[]
  syncs              RepositorySync[]
  files              RepositoryFile[]
  graphNodes         GraphNode[]
  graphEdges         GraphEdge[]
  embeddings         Embedding[]
  semanticIndexes    SemanticIndex[]

  @@index([githubRepositoryId])
}

model RepositoryFile {
  id           String      @id @default(uuid())
  repositoryId String
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  path         String
  name         String
  extension    String?
  size         Int         @default(0)
  sha          String
  type         String      @default("blob")
  parentPath   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  graphNodes   GraphNode[]
  embeddings   Embedding[]

  @@unique([repositoryId, path])
  @@index([repositoryId])
  @@index([path])
}

model RepositoryConnection {
  id             String     @id @default(uuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId   String
  repository     Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  connectedAt    DateTime   @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, repositoryId])
  @@index([userId])
  @@index([repositoryId])
}

model RepositorySync {
  id              String      @id @default(uuid())
  repositoryId    String
  repository      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  status          SyncStatus
  trigger         SyncTrigger
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  filesDiscovered Int         @default(0)
  filesProcessed  Int         @default(0)
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([repositoryId])
  @@index([status])
}

model GraphNode {
  id            String          @id @default(uuid())
  repositoryId  String
  repository    Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fileId        String?
  file          RepositoryFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  type          NodeType
  name          String
  qualifiedName String
  path          String?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  outgoingEdges GraphEdge[]     @relation("sourceNode")
  incomingEdges GraphEdge[]     @relation("targetNode")
  embeddings    Embedding[]

  @@unique([repositoryId, qualifiedName])
  @@index([repositoryId])
  @@index([type])
  @@index([fileId])
  @@index([qualifiedName])
}

model GraphEdge {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceNodeId String
  sourceNode   GraphNode  @relation("sourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String
  targetNode   GraphNode  @relation("targetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  type         EdgeType
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([repositoryId, sourceNodeId, targetNodeId, type])
  @@index([repositoryId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([type])
}

model Embedding {
  id           String          @id @default(uuid())
  repositoryId String
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  fileId       String?
  file         RepositoryFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  graphNodeId  String?
  graphNode    GraphNode?      @relation(fields: [graphNodeId], references: [id], onDelete: Cascade)
  contentHash  String
  content      String
  chunkIndex   Int             @default(0)
  totalChunks  Int             @default(1)
  model        String
  dimensions   Int
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([repositoryId, fileId, chunkIndex, model])
  @@index([repositoryId])
  @@index([fileId])
  @@index([contentHash])
  @@index([model])
}

model SemanticIndex {
  id              String      @id @default(uuid())
  repositoryId    String
  repository      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  status          SyncStatus  @default(PENDING)
  filesDiscovered Int         @default(0)
  filesProcessed  Int         @default(0)
  filesSkipped    Int         @default(0)
  filesFailed     Int         @default(0)
  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([repositoryId])
  @@index([status])
}
