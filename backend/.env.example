# Environment
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://architect_user:architect_password@localhost:5432/architectai_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_development_environment_123!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
MAX_REQUEST_BODY_SIZE=10mb

# OpenTelemetry Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=architectai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# GitHub Integration
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set Homepage URL to http://localhost:3000
# Set Authorization callback URL to http://localhost:3001/api/v1/github/callback (or http://localhost:3000/github/callback)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/github/callback
GITHUB_OAUTH_ENCRYPTION_KEY=12345678901234567890123456789012

# Semantic Embeddings
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MAX_FILE_SIZE=524288
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=200

# AI / RAG Foundation
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
LLM_BASE_URL=
MAX_CONTEXT_CHARS=8000
