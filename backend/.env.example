# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# PostgreSQL Connection
DATABASE_URL=postgresql://architect_user:architect_password@localhost:5432/architectai_db?schema=public

# Redis Connection
REDIS_URL=redis://localhost:6379

# JWT Secret configuration
JWT_SECRET=default_jwt_secret_must_be_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend & CORS Origins Settings
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
